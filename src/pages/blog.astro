---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---

<Base title="Blog">
  <h1>blog</h1>

  {posts.map(post => (
    <p>
      <a href={`/blog/${post.slug}`}>
        {post.data.title}
      </a>
    </p>
  ))}
</Base>