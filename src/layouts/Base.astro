---
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <script>
      const theme = localStorage.getItem("theme");

      if (
        theme === "dark" ||
        (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>

  <body>
    <header>
      <div class="left">
        <a href="/" class="brand">Krystian Spiewak</a>
      </div>

      <div class="right">
        <button id="theme-toggle">light / dark</button>
        <a href="/blog">blog</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <script>
      const toggle = document.getElementById("theme-toggle");

      toggle.addEventListener("click", () => {
        document.documentElement.classList.toggle("dark");

        if (document.documentElement.classList.contains("dark")) {
          localStorage.setItem("theme", "dark");
        } else {
          localStorage.setItem("theme", "light");
        }
      });
    </script>
  </body>
</html>

<style global>
  :root {
    --bg: #ffffff;
    --text: #111111;
    --muted: #666;
  }

  .dark {
    --bg: #000000;
    --text: #e5e5e5;
    --muted: #777;
  }

  * {
    box-sizing: border-box;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    max-width: 900px;
    margin: 120px auto;
    padding: 0 24px;
    line-height: 1.7;
    transition: background 0.2s ease, color 0.2s ease;
  }

  header {
    position: fixed;
    top: 40px;
    left: 60px;
    right: 60px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .right {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .brand {
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
  }

  button {
    background: none;
    border: none;
    color: var(--muted);
    font-family: inherit;
    cursor: pointer;
  }

  button:hover {
    color: var(--text);
  }

  a {
    color: var(--muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--text);
  }

  h1 {
    font-size: 2.4rem;
    margin-bottom: 8px;
  }

  h2 {
    margin-top: 80px;
    margin-bottom: 20px;
    font-size: 1.2rem;
    color: var(--muted);
  }

  p {
    margin: 20px 0;
    max-width: 720px;
  }

  ul {
    margin: 20px 0;
    padding-left: 20px;
  }

  li {
    margin: 8px 0;
  }

  hr {
    border: none;
    border-top: 1px solid #ddd;
    margin: 80px 0;
  }

  .dark hr {
    border-top: 1px solid #222;
  }
</style>