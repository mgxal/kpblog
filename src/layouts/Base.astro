---
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    <nav>
      <a href="/blog">blog</a>
    </nav>

    <main>
      <slot />
    </main>
  </body>
</html>

<style global>
  :root {
    --bg: #000;
    --text: #e5e5e5;
    --muted: #777;
  }

  * {
    box-sizing: border-box;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    max-width: 900px;
    margin: 120px auto;
    padding: 0 24px;
    line-height: 1.7;
  }

  nav {
    position: fixed;
    top: 40px;
    right: 60px;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: white;
  }

  h1 {
    font-size: 2.4rem;
    margin-bottom: 8px;
  }

  h2 {
    margin-top: 80px;
    margin-bottom: 20px;
    font-size: 1.2rem;
    color: var(--muted);
  }

  p {
    margin: 20px 0;
    max-width: 720px;
  }

  ul {
    margin: 20px 0;
    padding-left: 20px;
  }

  li {
    margin: 8px 0;
  }

  a {
    color: white;
    text-decoration: underline;
  }

  hr {
    border: none;
    border-top: 1px solid #222;
    margin: 80px 0;
  }
</style>