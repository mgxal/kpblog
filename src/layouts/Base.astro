---
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <script>
      const theme = localStorage.getItem("theme");
      if (
        theme === "dark" ||
        (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>

  <body>
    <div class="container">
      <header>
        <a href="/" class="brand">Krystian Spiewak</a>

        <div class="nav-right">
          <button id="theme-toggle" aria-label="Toggle theme">◐</button>
          <a href="/blog">blog</a>
        </div>
      </header>

      <main>
        <slot />
      </main>
    </div>

    <script>
      const toggle = document.getElementById("theme-toggle");

      toggle.addEventListener("click", () => {
        document.documentElement.classList.toggle("dark");

        if (document.documentElement.classList.contains("dark")) {
          localStorage.setItem("theme", "dark");
        } else {
          localStorage.setItem("theme", "light");
        }
      });
    </script>
  </body>
</html>

<style global>
  :root {
    --bg: #ffffff;
    --text: #111111;
    --muted: #666;
    --border: #e5e5e5;
  }

  .dark {
    --bg: #000000;
    --text: #e5e5e5;
    --muted: #777;
    --border: #222;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .container {
    max-width: 900px;
    margin: 80px auto;
    padding: 0 24px;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 100px;
  }

  .brand {
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
  }

  .nav-right {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  button {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--muted);
    font-size: 1rem;
  }

  button:hover {
    color: var(--text);
  }

  a {
    text-decoration: none;
    color: var(--muted);
  }

  a:hover {
    color: var(--text);
  }

  h1 {
    font-size: 2.4rem;
    margin-bottom: 8px;
  }

  h2 {
    margin-top: 80px;
    margin-bottom: 20px;
    font-size: 1.1rem;
    color: var(--muted);
  }

  p {
    margin: 20px 0;
    max-width: 720px;
  }

  ul {
    margin: 20px 0;
    padding-left: 20px;
  }

  li {
    margin: 8px 0;
  }

  hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 80px 0;
  }
</style>