---
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style global>
  :root {
    --bg: #000;
    --text: #e5e5e5;
    --muted: #777;
  }

  * {
    box-sizing: border-box;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    max-width: 760px;
    margin: 120px auto;
    padding: 0 24px;
    line-height: 1.7;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 40px;
  }

  p {
    margin: 24px 0;
  }

  ul {
    margin: 24px 0;
    padding-left: 20px;
  }

  li {
    margin: 8px 0;
  }

  a {
    color: white;
    text-decoration: underline;
  }

  hr {
    border: none;
    border-top: 1px solid #222;
    margin: 64px 0;
  }
</style>